# Project-specific R8 rules. AGP combines every file in src/main/keepRules and passes it to R8.
# For more details, see https://d.android.com/r/tools/r8/keep-rules

# Ktor optionally logs through SLF4J, which is not bundled on Android.
-dontwarn org.slf4j.**
-dontwarn org.slf4j.impl.StaticLoggerBinder

# Ktor references JVM-only management classes that do not exist on Android.
-dontwarn java.lang.management.**
